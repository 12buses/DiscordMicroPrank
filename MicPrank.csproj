<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MicPrank</AssemblyName>
    <RootNamespace>MicPrank</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>MicPrank</Authors>
    <Description>Случайно выключает микрофон в Discord на пару секунд.</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.3.0" />
  </ItemGroup>

</Project>
